rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Health / connection test doc
    match /test/connection {
      allow read: if true;
    }

    // User profile document: strictly isolated to the authenticated user
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasAll(['uid', 'email'])
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'lastLoginAt']);
      allow update: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'lastLoginAt']);
      allow delete: if isOwner(userId);
    }

    // Documents collection: Row-Level Security ensures users can only read and write their own documents
    match /documents/{documentId} {
      allow get: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow list: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(documentId)
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.id == documentId
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 250
        && request.resource.data.raw_text is string
        && request.resource.data.raw_text.size() <= 100000
        && request.resource.data.created_at is string;
      allow update: if isSignedIn()
        && isValidId(documentId)
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 250
        && request.resource.data.raw_text is string
        && request.resource.data.raw_text.size() <= 100000;
      allow delete: if isSignedIn()
        && isValidId(documentId)
        && resource.data.user_id == request.auth.uid;
    }

    // Questions collection (flashcard / multiple_choice)
    match /questions/{questionId} {
      allow get: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow list: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(questionId)
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.id == questionId
        && (request.resource.data.type == 'flashcard' || request.resource.data.type == 'multiple_choice')
        && request.resource.data.topic is string
        && request.resource.data.topic.size() <= 150;
      allow update: if isSignedIn()
        && isValidId(questionId)
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == request.auth.uid
        && (request.resource.data.type == 'flashcard' || request.resource.data.type == 'multiple_choice')
        && request.resource.data.topic is string
        && request.resource.data.topic.size() <= 150;
      allow delete: if isSignedIn()
        && isValidId(questionId)
        && resource.data.user_id == request.auth.uid;
    }

    // Progress collection (spaced repetition tracking)
    match /progress/{progressId} {
      allow get: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow list: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(progressId)
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.id == progressId
        && request.resource.data.times_correct is number
        && request.resource.data.times_wrong is number;
      allow update: if isSignedIn()
        && isValidId(progressId)
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.times_correct is number
        && request.resource.data.times_wrong is number;
      allow delete: if isSignedIn()
        && isValidId(progressId)
        && resource.data.user_id == request.auth.uid;
    }

    // Chat sessions collection
    match /chat_sessions/{sessionId} {
      allow get: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow list: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(sessionId)
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.id == sessionId
        && request.resource.data.messages is list;
      allow update: if isSignedIn()
        && isValidId(sessionId)
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.messages is list;
      allow delete: if isSignedIn()
        && isValidId(sessionId)
        && resource.data.user_id == request.auth.uid;
    }
  }
}
